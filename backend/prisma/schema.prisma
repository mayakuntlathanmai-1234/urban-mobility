generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      String   @default("PASSENGER") // PASSENGER, DRIVER, ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver         Driver?
  passengerRides Ride[]         @relation("PassengerRides")
  ratingsGiven   Rating[]       @relation("PassengerRatings")
  notifications  Notification[]
}

model Driver {
  id            String   @id @default(uuid())
  userId        String   @unique
  licenseNumber String
  isOnline      Boolean  @default(false)
  currentLat    Float    @default(16.5062)
  currentLng    Float    @default(80.6480)
  rating        Float    @default(4.8)
  totalRides    Int      @default(0)
  totalEarnings Float    @default(0.0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle       Vehicle?
  driverRides   Ride[]         @relation("DriverRides")
  rideLocations RideLocation[]
  ratingsRecv   Rating[]       @relation("DriverRatings")
}

model Vehicle {
  id          String   @id @default(uuid())
  driverId    String   @unique
  make        String
  model       String
  year        Int      @default(2023)
  color       String
  plateNumber String   @unique
  type        String   @default("SEDAN") // BIKE, AUTO, SEDAN, SUV
  capacity    Int      @default(4)
  createdAt   DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model Ride {
  id               String        @id @default(uuid())
  rideNumber       String        @unique
  passengerId      String
  driverId         String?
  pickupLat        Float
  pickupLng        Float
  pickupAddress    String
  destLat          Float
  destLng          Float
  destAddress      String
  rideType         String        @default("SEDAN") // BIKE, AUTO, SEDAN, SUV
  status           String        @default("REQUESTED") // REQUESTED, SEARCHING_DRIVER, DRIVER_ASSIGNED, etc.
  distanceKm       Float
  estimatedTimeMin Int
  baseFare         Float
  perKmFare        Float
  estimatedFare    Float
  finalFare        Float?
  paymentMethod    String        @default("CASH")
  paymentStatus    String        @default("PENDING") // PENDING, SUCCESS, etc.
  requestedAt      DateTime      @default(now())
  assignedAt       DateTime?
  arrivedAt        DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?

  passenger     User           @relation("PassengerRides", fields: [passengerId], references: [id])
  driver        Driver?        @relation("DriverRides", fields: [driverId], references: [id])
  rideLocations RideLocation[]
  payment       Payment?
  rating        Rating?
}

model RideLocation {
  id        String   @id @default(uuid())
  rideId    String
  driverId  String
  latitude  Float
  longitude Float
  timestamp DateTime @default(now())

  ride   Ride   @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String   @id @default(uuid())
  rideId        String   @unique
  amount        Float
  paymentMethod String   @default("CASH")
  status        String   @default("PENDING")
  transactionId String?
  createdAt     DateTime @default(now())

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
}

model Rating {
  id          String   @id @default(uuid())
  rideId      String   @unique
  passengerId String
  driverId    String
  score       Int      @default(5)
  comment     String?
  createdAt   DateTime @default(now())

  ride      Ride   @relation(fields: [rideId], references: [id], onDelete: Cascade)
  passenger User   @relation("PassengerRatings", fields: [passengerId], references: [id])
  driver    Driver @relation("DriverRatings", fields: [driverId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FareConfig {
  id          String   @id @default(uuid())
  vehicleType String   @unique // BIKE, AUTO, SEDAN, SUV
  baseFare    Float
  perKmFare   Float
  perMinFare  Float    @default(2.0)
  minFare     Float    @default(30.0)
  capacity    Int
  description String
  updatedAt   DateTime @updatedAt
}
